{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "0.0.1",
  "firefox:browser_specific_settings": {
    "gecko": {
      "id": "{236132f6-b60c-4b13-9069-298b392cbc92}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "Materialious Companion",
  "description": "Adds a browser request bridge for Materialious.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Materialious Companion"
  },
  "firefox:browser_action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Materialious Companion"
  },
  "chromium:permissions": [
    "tabs",
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "firefox:permissions": [
    "tabs",
    "storage",
    "https://app.materialio.us/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "https://*.googlevideo.com/*",
    "https://*.ytimg.com/*"
  ],
  "chromium:host_permissions": [
    "https://app.materialio.us/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "https://*.googlevideo.com/*",
    "https://*.ytimg.com/*"
  ],
  "chromium:optional_host_permissions": ["http://*/*", "https://*/*"],
  "chromium:content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "firefox:optional_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": ["background.ts"]
  },
  "content_scripts": [
    {
      "matches": ["https://app.materialio.us/*"],
      "js": ["content/scripts.ts"]
    }
  ],
  "chromium:web_accessible_resources": [
    {
      "resources": ["page/bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "firefox:web_accessible_resources": ["page/bridge.js"]
}
